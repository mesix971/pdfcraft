<?xml version="1.0" encoding="utf-8"?>
<!-- PdfCraft for Android. `cargo xtask android` fills in the version and builds the APK
     (apps/pdfcraft-android/README.md). The app is native code in a NativeActivity: no Java.

     The SDK levels come from `cargo xtask android` (minimum 26, Android 8.0; target 34). Target 35
     would draw the app under the status and navigation bars (Android 15 enforces edge-to-edge),
     and NativeActivity reports no insets for those. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ai.storyteller.pdfcraft"
    android:installLocation="auto">

    <!-- Open and save documents anywhere on shared storage: the storage permissions up to
         Android 10, "all files access" from Android 11 (the app asks in its file browser). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- No INTERNET permission: PdfCraft works offline and sends nothing. -->

    <!-- wgpu draws with Vulkan, or OpenGL ES 3 where Vulkan is missing. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="PdfCraft"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:resizeableActivity="true"
        android:appCategory="productivity">

        <!-- singleTask: one window, so a document opened from another app joins it instead of
             starting a second copy. configChanges: turning the device or folding it resizes the
             window; it never restarts the app and its open documents. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection|fontScale|touchscreen|colorMode|mcc|mnc">

            <meta-data android:name="android.app.lib_name" android:value="pdfcraft_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with PdfCraft" from file managers, mail and the browser's downloads. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- "Share to PdfCraft". -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>
    </application>
</manifest>
